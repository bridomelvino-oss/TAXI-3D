# ─── Newsletter (Brevo) ───────────────────────────────────────────────────────
#
# 1. Crée un compte gratuit sur https://app.brevo.com
# 2. Va dans : Paramètres → Clés API → Créer une clé
# 3. Copie la clé ci-dessous
#
BREVO_API_KEY=your_brevo_api_key_here
#
# 4. Va dans : Contacts → Listes → note l'ID de ta liste (ex : 2)
#    (Brevo crée une liste "Ma liste de contacts" par défaut avec l'ID 2)
#
BREVO_LIST_ID=2
